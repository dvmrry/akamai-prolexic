# Akamai EdgeGrid credentials live in ~/.edgerc; never in this repo.
.edgerc
.env
.env.*
bin/
dist/
/prolexic
coverage.out
*.test
.direnv/
.claude/settings.local.json
# Transient scratch space (run output, captured API responses); never tracked.
/scratch/
# Akamai specs from behind the login (see spec/README.md); only the README is tracked.
/spec/*
!/spec/README.md

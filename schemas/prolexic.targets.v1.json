{
  "$id": "prolexic.targets.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "description": "When the document was made (RFC 3339, UTC).",
      "type": "string"
    },
    "prolexic": {
      "description": "The prolexic version that made it.",
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "targets": {
      "description": "Sorted by targetName, targetId.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "createdTime": {
            "description": "ISO 8601, as the API reports it.",
            "type": "string"
          },
          "modifiedBy": {
            "type": "string"
          },
          "modifiedTime": {
            "description": "ISO 8601, as the API reports it.",
            "type": "string"
          },
          "ports": {
            "description": "The TCP ports monitored.",
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "targetDomain": {
            "description": "The domain for HTTP tests; null or empty (shown absent) for TCP.",
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "targetIp": {
            "description": "A single address for TCP tests; null (shown absent) for HTTP.",
            "type": "string"
          },
          "targetName": {
            "type": "string"
          },
          "testIds": {
            "description": "The test ids the target uses.",
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "testType": {
            "description": "TCP or HTTP.",
            "type": "string"
          }
        },
        "required": [
          "ports",
          "targetId",
          "targetName",
          "testIds",
          "testType"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "targets"
  ],
  "type": "object"
}

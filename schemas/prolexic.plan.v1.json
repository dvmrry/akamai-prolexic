{
  "$id": "prolexic.plan.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountId": {
      "type": "string"
    },
    "aliases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "activeVersion": {
            "description": "The conflict token: apply refuses if it moved. Empty when the API doesn't expose versions.",
            "type": "string"
          },
          "add": {
            "items": {
              "oneOf": [
                {
                  "description": "A prefix, GEO::\u003ccountry\u003e or ASN::\u003cnumber\u003e, without metadata.",
                  "type": "string"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "added": {
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "type": "string"
                    },
                    "cidr": {
                      "type": "string"
                    },
                    "expires": {
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "ticket": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cidr"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "id": {
            "type": "integer"
          },
          "ipVersion": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prodVersion": {
            "type": "string"
          },
          "remove": {
            "items": {
              "oneOf": [
                {
                  "description": "A prefix, GEO::\u003ccountry\u003e or ASN::\u003cnumber\u003e, without metadata.",
                  "type": "string"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "added": {
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "type": "string"
                    },
                    "cidr": {
                      "type": "string"
                    },
                    "expires": {
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "ticket": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cidr"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "role": {
            "description": "The effective role: derived from the deployed rules when one references the alias, else the file's.",
            "type": "string"
          },
          "roleSource": {
            "enum": [
              "rules",
              "file",
              "unverified"
            ],
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "unchanged": {
            "type": "integer"
          }
        },
        "required": [
          "activeVersion",
          "add",
          "id",
          "ipVersion",
          "name",
          "prodVersion",
          "remove",
          "role",
          "roleSource",
          "type",
          "unchanged"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "changes": {
      "type": "boolean"
    },
    "digest": {
      "description": "sha256 over each alias's id, name, activeVersion and changes; apply --expect-digest must match.",
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "alias": {
            "type": "string"
          },
          "code": {
            "description": "Stable machine-readable reason, e.g. bogon, own_space, host_bits.",
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ],
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "severity"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ownSpaceAnalytics": {
      "description": "Whether Prolexic Analytics protected prefixes were part of the own-space check.",
      "type": "boolean"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "accountId",
    "aliases",
    "changes",
    "digest",
    "file",
    "findings",
    "ownSpaceAnalytics",
    "schema"
  ],
  "type": "object"
}

{
  "$id": "prolexic.apply.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "file": {
      "type": "string"
    },
    "generatedAt": {
      "description": "When the document was made (RFC 3339, UTC).",
      "type": "string"
    },
    "plan": {
      "additionalProperties": false,
      "description": "The fresh plan apply computed.",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "aliases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "activeVersion": {
                "description": "The conflict token: apply refuses if it moved. Empty when the API doesn't expose versions.",
                "type": "string"
              },
              "add": {
                "items": {
                  "oneOf": [
                    {
                      "description": "A prefix, GEO::\u003ccountry\u003e or ASN::\u003cnumber\u003e, without metadata.",
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "added": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "cidr": {
                          "type": "string"
                        },
                        "expires": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "ticket": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "cidr"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "desiredHash": {
                "description": "sha256 over the alias's expected entries after apply (canonical, sorted): verify compares live with it.",
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "ipVersion": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "prodVersion": {
                "type": "string"
              },
              "remove": {
                "items": {
                  "oneOf": [
                    {
                      "description": "A prefix, GEO::\u003ccountry\u003e or ASN::\u003cnumber\u003e, without metadata.",
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "added": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "cidr": {
                          "type": "string"
                        },
                        "expires": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "ticket": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "cidr"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "role": {
                "description": "The effective role: derived from the deployed rules when one references the alias, else the file's.",
                "type": "string"
              },
              "roleSource": {
                "enum": [
                  "rules",
                  "file",
                  "unverified"
                ],
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "unchanged": {
                "type": "integer"
              }
            },
            "required": [
              "activeVersion",
              "add",
              "desiredHash",
              "id",
              "ipVersion",
              "name",
              "prodVersion",
              "remove",
              "role",
              "roleSource",
              "type",
              "unchanged"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "changes": {
          "type": "boolean"
        },
        "checks": {
          "additionalProperties": false,
          "properties": {
            "deployedRules": {
              "description": "Deployed ACL rules read to derive alias sides; 0 when no alias in the file is used by one.",
              "type": "integer"
            },
            "liveChecksRan": {
              "description": "False when the offline checks failed, so the counts below are zero because nothing live was checked.",
              "type": "boolean"
            },
            "ownASNs": {
              "description": "Own AS numbers that ASN:: entries were checked against.",
              "type": "integer"
            },
            "ownSpace": {
              "description": "Each own-space source and how many prefixes it gave, sorted by source.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "prefixes": {
                    "type": "integer"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "prefixes",
                  "source"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "deployedRules",
            "liveChecksRan",
            "ownASNs",
            "ownSpace"
          ],
          "type": "object"
        },
        "digest": {
          "description": "sha256 over each alias's id, name, activeVersion, changes and desiredHash; apply refuses unless given this digest.",
          "type": "string"
        },
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "alias": {
                "type": "string"
              },
              "code": {
                "description": "Stable machine-readable reason, e.g. bogon, own_space, host_bits.",
                "type": "string"
              },
              "entry": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ],
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "severity"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "accountId",
        "aliases",
        "changes",
        "checks",
        "digest",
        "findings"
      ],
      "type": "object"
    },
    "prolexic": {
      "description": "The prolexic version that made it.",
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "description": "Absent when apply refused before writing (plan errors, digest moved).",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "aliases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "activatedAt": {
                "description": "When this apply activated the version (RFC 3339; a BIG upload activates on arrival).",
                "type": "string"
              },
              "add": {
                "items": {
                  "oneOf": [
                    {
                      "description": "A prefix, GEO::\u003ccountry\u003e or ASN::\u003cnumber\u003e, without metadata.",
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "added": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "cidr": {
                          "type": "string"
                        },
                        "expires": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "ticket": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "cidr"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "error": {
                "type": "string"
              },
              "fromVersion": {
                "type": "string"
              },
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "productionAt": {
                "description": "The first poll that saw production carry the version (RFC 3339): accurate to the poll interval.",
                "type": "string"
              },
              "remove": {
                "items": {
                  "oneOf": [
                    {
                      "description": "A prefix, GEO::\u003ccountry\u003e or ASN::\u003cnumber\u003e, without metadata.",
                      "type": "string"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "added": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "cidr": {
                          "type": "string"
                        },
                        "expires": {
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "ticket": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "cidr"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              "status": {
                "enum": [
                  "unchanged",
                  "skipped",
                  "failed",
                  "created",
                  "active",
                  "deployed",
                  "rolled_back"
                ],
                "type": "string"
              },
              "version": {
                "description": "The version this apply created.",
                "type": "string"
              },
              "waitedForProduction": {
                "description": "Unchanged, but production lagged its active version (activated earlier or by someone else), so apply waited on it without writing it.",
                "type": "boolean"
              }
            },
            "required": [
              "add",
              "fromVersion",
              "id",
              "name",
              "remove",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "alreadyApplied": {
          "description": "Live already matched the file, so nothing was written; apply only waited for production to catch up.",
          "type": "boolean"
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "accountId",
        "aliases",
        "alreadyApplied",
        "digest"
      ],
      "type": "object"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "file",
    "schema"
  ],
  "type": "object"
}

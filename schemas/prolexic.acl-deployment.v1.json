{
  "$id": "prolexic.acl-deployment.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "production": {
      "description": "The version in production; 0 when none is.",
      "type": "integer"
    },
    "ruleSets": {
      "description": "As the API reports them, in its order.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "deploymentStatus": {
            "description": "PRODUCTION, PROCESSING or FAILED.",
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "ruleSet": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "aclText": {
                  "type": "string"
                },
                "installStatus": {
                  "description": "INSTALLED, NOT_INSTALLED or FAILED.",
                  "type": "string"
                },
                "ruleUuid": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "rulesDeployStats": {
            "additionalProperties": false,
            "properties": {
              "failed": {
                "type": "integer"
              },
              "installed": {
                "type": "integer"
              },
              "notInstalled": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            },
            "required": [
              "failed",
              "installed",
              "notInstalled",
              "total"
            ],
            "type": "object"
          },
          "statusRetrievalTimestamp": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "deploymentStatus",
          "ruleSet",
          "rulesDeployStats",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "production",
    "ruleSets",
    "schema"
  ],
  "type": "object"
}

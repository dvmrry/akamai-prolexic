{
  "$id": "prolexic.managed-rule-hits.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "description": "When the document was made (RFC 3339, UTC).",
      "type": "string"
    },
    "policyDomain": {
      "type": "string"
    },
    "prolexic": {
      "description": "The prolexic version that made it.",
      "type": "string"
    },
    "rules": {
      "description": "Sorted by ruleId. With --rule, only that rule.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "type": "integer"
          },
          "firstMatch": {
            "type": "string"
          },
          "lastMatch": {
            "type": "string"
          },
          "lastReset": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string"
          },
          "matches": {
            "type": "integer"
          },
          "ruleId": {
            "description": "The rule's id (its uuid).",
            "type": "string"
          }
        },
        "required": [
          "bytes",
          "matches",
          "ruleId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    },
    "series": {
      "additionalProperties": false,
      "description": "Present only with --rule: that rule's time series over the window (default the last 24h).",
      "properties": {
        "averageMatches": {
          "type": "number"
        },
        "end": {
          "description": "Window end as the API reports it.",
          "type": "string"
        },
        "peakMatches": {
          "type": "number"
        },
        "points": {
          "description": "In time order.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "bytes": {
                "type": "integer"
              },
              "matches": {
                "type": "integer"
              },
              "timestamp": {
                "type": "string"
              }
            },
            "required": [
              "bytes",
              "matches",
              "timestamp"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "resolution": {
          "description": "Bucket size the API chose: 5m, 1h or 1d.",
          "type": "string"
        },
        "start": {
          "description": "Window start as the API reports it.",
          "type": "string"
        },
        "totalMatches": {
          "type": "integer"
        }
      },
      "required": [
        "averageMatches",
        "end",
        "peakMatches",
        "points",
        "start",
        "totalMatches"
      ],
      "type": "object"
    }
  },
  "required": [
    "policyDomain",
    "rules",
    "schema"
  ],
  "type": "object"
}
